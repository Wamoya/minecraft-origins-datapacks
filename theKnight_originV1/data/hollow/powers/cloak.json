{
	"name": "[Primary] Mothwing cloak",
	"description": "Cloak threaded with mothwing strands. Allows the wearer to dash forwards along the ground or through the air.",
	"type": "origins:multiple",
	"cloak": {
		"type": "origins:active_self",
		"entity_action": {
			"type": "origins:and",
			"actions": [
				{
					"type": "origins:add_velocity",
					"z": 0.8,
					"space": "local",
					"set": true
				},
				{
					"type": "origins:execute_command",
					"command": "playsound minecraft:block.wool.break player @a[distance=..8]"
				},
				{
					"type": "origins:execute_command",
					"command": "particle minecraft:smoke ~ ~.5 ~ 0 0 0 0.1 20 force"
				},
				{
					"type": "origins:change_resource",
					"resource": "*:*_ground",
					"change": -1
				}
			]
		},
		"cooldown": 20,
		"condition": {
			"type": "origins:resource",
			"resource": "*:*_ground",
			"comparison": "==",
			"compare_to": 1
		}
	},
	"ground": {
		"type": "origins:resource",
		"min": 0,
		"max": 1
	},
	"ground_up": {
		"type": "origins:action_over_time",
		"interval": 1,
		"entity_action": {
			"type": "origins:change_resource",
			"resource": "*:*_ground",
			"change": 1
		},
		"condition": {
			"type": "origins:and",
			"conditions": [
				{
					"type": "origins:on_block"
				},
				{
					"type": "origins:resource",
					"resource": "*:*_ground",
					"comparison": "==",
					"compare_to": 0
				}
			]
		}
	}
}