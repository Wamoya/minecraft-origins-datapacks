{
	"name": "Shade",
	"description": "Each of us leaves an imprint of something when we die.",
	"type": "origins:multiple",
	"vex": {
		"type": "origins:resource",
		"min": 0,
		"max": 1,
		"max_action": {
			"type": "origins:and",
			"actions": [
				{
					"type": "origins:execute_command",
					"command": "summon minecraft:vex"
				},
				{
					"type": "origins:execute_command",
					"command": "power grant @e[distance=..1] hollow:void"
				}
			]
		}
	},
	"alive": {
		"type": "origins:action_over_time",
		"interval": 1,
		"entity_action": {
			"type": "origins:change_resource",
			"resource": "*:*_vex",
			"change": -1
		},
		"condition": {
			"type": "origins:health",
			"comparison": ">",
			"compare_to": 0
		}
	},
	"dead": {
		"type": "origins:action_over_time",
		"interval": 1,
		"entity_action": {
			"type": "origins:change_resource",
			"resource": "*:*_vex",
			"change": 1
		},
		"condition": {
			"type": "origins:health",
			"comparison": "==",
			"compare_to": 0
		}
	}
}