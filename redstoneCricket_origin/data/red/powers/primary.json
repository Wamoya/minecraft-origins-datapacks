{
	"name": "Redstone beam Mk.III",
	"description": "You can use your own energy to overload redstone in your inventory and shoot it at the same time.",
	"type": "origins:active_self",
	"badges": [
		{
			"type":"origins:keybind",
			"sprite":"origins:textures/gui/badge/active.png",
			"text": "Press %s while having redstone."
		},
		{
			"type":"origins:tooltip",
			"sprite":"origins:textures/gui/badge/info.png",
			"text": "Will inflict damage to entities."
		},
		{
			"type":"origins:tooltip",
			"sprite":"origins:textures/gui/badge/info.png",
			"text": "Will interact with:\n- Buttons, levers, and pressure plates\n- Doors and trapdoors\n- Redstone torches and lamps"
		}
	],
	"entity_action": {
		"type":"origins:raycast",
		"distance": 16,
		"before_action":{
			"type":"origins:and",
			"actions": [
				{
					"type": "origins:execute_command",
					"command": "clear @s minecraft:redstone 1",
					"permission_level":4
				},
				{
					"type":"origins:play_sound",
					"sound": "minecraft:block.beacon.activate"
				},
				{
					"type":"origins:exhaust",
					"amount": 10
				}
			]
		},
		"command_along_ray":"particle minecraft:dust 1 0 0 1 ~ ~ ~ .01 .01 .01 .1 5 force",
		"bientity_action":{
			"type":"origins:target_action",
			"action":{
				"type":"origins:and",
				"actions":[
					{
						"type":"origins:damage",
						"amount":5,
						"source":{
							"name":"onFire",
							"fire":true,
							"bypasses_armor":true
						}
					}
				]
			}
		},
		"block_action":{
			"type":"origins:and",
			"actions":[
				{
					"type":"origins:modify_block_state",
					"property": "lit",
					"cycle": true
				},
				{
					"type":"origins:modify_block_state",
					"property": "powered",
					"cycle": true
				},
				{
					"type":"origins:modify_block_state",
					"property": "open",
					"cycle": true
				}
			]
		}
	},
	"cooldown": 60,
	"hud_render": {
		"should_render": true,
		"sprite_location":"origins:textures/gui/community/huang/resource_bar_02.png",
		"bar_index": 5
	},
	"condition": {
		"type":"origins:and",
		"conditions": [
			{
				"type": "origins:command",
				"command": "execute if entity @s[nbt={Inventory:[{id:\"minecraft:redstone\"}]}]",
				"comparison": ">",
				"compare_to": 0
			},
			{
				"type":"origins:food_level",
				"comparison": ">=",
				"compare_to": 5
			}
		]
	}
}