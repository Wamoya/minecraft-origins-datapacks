{
    "hidden":true,
    "type":"origins:multiple",
    "resource":{
        "type":"origins:resource",
        "min":0,
        "max":3,
        "hud_render":{"should_render":false}
    },
    "resource_down":{
        "type":"origins:action_over_time",
        "interval":20,
        "entity_action": {
            "type":"origins:change_resource",
            "resource": "*:*_resource",
            "change": -1
        },
        "condition": {
            "type":"origins:resource",
            "resource": "*:*_resource",
            "comparison":">",
            "compare_to": 0
        }
    },
    "active":{
        "type":"origins:active_self",
        "entity_action": {
            "type":"origins:and",
            "actions": [
                {
                    "type":"origins:change_resource",
                    "resource": "*:*_resource",
                    "change": 3
                },
                {
                    "type":"origins:play_sound",
                    "sound": "minecraft:block.beacon.deactivate"
                }
            ]
        },
        "cooldown":200,
        "hud_render":{
            "should_render":true,
            "sprite_location":"origins:textures/gui/community/spiderkolo/resource_bar_02.png",
            "bar_index":7
        },
        "key":{"key":"key.loadToolbarActivator"},
        "condition": {
            "type":"origins:xp_levels",
            "comparison": ">=",
            "compare_to": 5
        }
    },
    "glow":{
        "type":"origins:entity_glow",
        "bientity_condition": {
            "type":"origins:target_condition",
            "condition": {
                "type":"origins:sneaking"
            },
            "inverted": true
        },
        "condition": {
            "type":"origins:resource",
            "resource": "*:*_resource",
            "comparison":">",
            "compare_to": 0
        }
    }
}