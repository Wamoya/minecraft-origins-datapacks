{
	"type": "origins:multiple",
	"name": "Tempo",
	"description": "Keeping the tempo up will result in §3amazing§r §3performances.§r §oJust try not to draw too much attention!",
	"badges": [
		{
			"type": "origins:keybind",
			"sprite": "origins:textures/gui/badge/active.png",
			"text": "[Active Power (Secondary)]\n\n§oIs §c§owidely recommended§r §oto bound this ability to an §naccessible key,§r §osuch as the Middle Mouse Button"
		},
		{
			"type": "origins:tooltip",
			"sprite": "origins:textures/gui/badge/info.png",
			"text": "While on §33 streak points,§r you will have the §e§oGlowing§r effect"
		},
		{
			"type": "origins:tooltip",
			"sprite": "origins:textures/gui/badge/info.png",
			"text": "# You will §close streak§r §oif:§r\n- §nDeal§r / §nReceive§r damage\n- §nUse certain features§r of the origin\n- §nFail§r this active ability"
		}
	],
	"resource": {
		"type": "origins:resource",
		"min": 0,
		"max": 10,
		"hud_render": {
			"should_render": true,
			"sprite_location": "origins:textures/gui/community/spiderkolo/resource_bar_points_01.png",
			"bar_index": 18
		}
	},
	"res_up": {
		"type": "origins:active_self",
		"entity_action": {
			"type": "origins:if_else",
			"condition": {
				"type": "origins:or",
				"conditions": [
					{
						"type": "origins:resource",
						"resource": "*:metronome_resource",
						"comparison": "<=",
						"compare_to": 5
					},
					{
						"type": "origins:resource",
						"resource": "*:metronome_resource",
						"comparison": ">=",
						"compare_to": 15
					}
				]
			},
			"if_action": {
				"type": "origins:if_else_list",
				"actions": [
					{
						"condition": {
							"type": "origins:resource",
							"resource": "*:*_resource",
							"comparison": "==",
							"compare_to": 0
						},
						"action": {
							"type": "origins:execute_command",
							"command": "function music:success0",
							"permission_level": 4
						}
					},
					{
						"condition": {
							"type": "origins:resource",
							"resource": "*:*_resource",
							"comparison": "==",
							"compare_to": 1
						},
						"action": {
							"type": "origins:execute_command",
							"command": "function music:success1",
							"permission_level": 4
						}
					},
					{
						"condition": {
							"type": "origins:resource",
							"resource": "*:*_resource",
							"comparison": "==",
							"compare_to": 2
						},
						"action": {
							"type": "origins:execute_command",
							"command": "function music:success2",
							"permission_level": 4
						}
					}
				]
			},
			"else_action": {
				"type": "origins:execute_command",
				"command": "function music:failure",
				"permission_level": 4,
				"condition": {
					"type": "origins:resource",
					"resource": "*:freestyle_resource",
					"comparison": "==",
					"compare_to": 0
				}
			}
		},
		"key": {"key": "key.origins.secondary_active"},
		"cooldown": 10,
		"hud_render": {"should_render": false},
		"condition": {
			"type": "origins:and",
			"conditions": [
				{
					"type": "origins:resource",
					"resource": "*:metronome_toggle_resource",
					"comparison": "==",
					"compare_to": 1
				},
				{
					"type": "origins:resource",
					"resource": "*:*_resource",
					"comparison": "<",
					"compare_to": 3
				}
			]
		}
	},
	"res_down_when_hit": {
		"type": "origins:self_action_when_hit",
		"entity_action": {
			"type": "origins:change_resource",
			"resource": "*:*_resource",
			"change": -1
		},
		"cooldown": 1,
		"condition": {
			"type": "origins:resource",
			"resource": "*:freestyle_resource",
			"comparison": "==",
			"compare_to": 0
		}
	},
	"res_down_on_hit": {
		"type": "origins:self_action_on_hit",
		"entity_action": {
			"type": "origins:delay",
			"ticks": 1,
			"action": {
				"type": "origins:change_resource",
				"resource": "*:*_resource",
				"change": -1
			}
		},
		"cooldown": 1,
		"condition": {
			"type": "origins:resource",
			"resource": "*:freestyle_resource",
			"comparison": "==",
			"compare_to": 0
		}
	},
	"glow": {
		"type": "origins:action_over_time",
		"interval": 10,
		"entity_action": {
			"type": "origins:apply_effect",
			"effect": {
				"effect": "minecraft:glowing",
				"amplifier": 0,
				"duration": 20,
				"show_icon": false,
				"show_particles": false
			}
		},
		"condition": {
			"type": "origins:resource",
			"resource": "*:*_resource",
			"comparison": "==",
			"compare_to": 3
		}
	}
}