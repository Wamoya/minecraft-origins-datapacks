{
	"name":"§e§nLight",
	"description": "You gain §elight§r while being under §ndirect sunlight§r §o(or moonlight).§r\nYou use §eit§r to maintain the bond between you and your gemstone.\n§0Using too much §elight§r §0will result in §ka punish..",
	"type":"origins:multiple",
	"badges": [],
	"light":{
		"type":"origins:resource",
		"min":0,
		"max":7,
		"start_value": 6,
		"hud_render": {
			"should_render":true,
			"sprite_location":"origins:textures/gui/community/spiderkolo/resource_bar_02.png",
			"bar_index": 24
		},
		"min_action": {
			"type": "origins:and",
			"actions": [
				{
					"type": "origins:if_else_list",
					"actions": [
						{
							"condition": {
								"type": "origins:resource",
								"resource": "*:current_resource",
								"comparison": "==",
								"compare_to": 1
							},
							"action": {
								"type": "origins:delay",
								"ticks": 1,
								"action": {
									"type": "origins:execute_command",
									"command": "give @s minecraft:amethyst_shard",
									"permission_level": 4
								}
							}
						},
						{
							"condition": {
								"type": "origins:resource",
								"resource": "*:current_resource",
								"comparison": "==",
								"compare_to": 2
							},
							"action": {
								"type": "origins:delay",
								"ticks": 1,
								"action": {
									"type": "origins:execute_command",
									"command": "give @s minecraft:diamond",
									"permission_level": 4
								}
							}
						},
						{
							"condition": {
								"type": "origins:resource",
								"resource": "*:current_resource",
								"comparison": "==",
								"compare_to": 3
							},
							"action": {
								"type": "origins:delay",
								"ticks": 1,
								"action": {
									"type": "origins:execute_command",
									"command": "give @s minecraft:emerald",
									"permission_level": 4
								}
							}
						},
						{
							"condition": {
								"type": "origins:resource",
								"resource": "*:current_resource",
								"comparison": "==",
								"compare_to": 4
							},
							"action": {
								"type": "origins:delay",
								"ticks": 1,
								"action": {
									"type": "origins:execute_command",
									"command": "give @s minecraft:lapis_lazuli",
									"permission_level": 4
								}
							}
						},
						{
							"condition": {
								"type": "origins:resource",
								"resource": "*:current_resource",
								"comparison": "==",
								"compare_to": 5
							},
							"action": {
								"type": "origins:delay",
								"ticks": 1,
								"action": {
									"type": "origins:execute_command",
									"command": "give @s minecraft:redstone",
									"permission_level": 4
								}
							}
						}
					]
				},
				{
					"type": "origins:change_resource",
					"resource": "*:current_resource",
					"change": 0,
					"operation": "set"
				},
				{
					"type":"origins:execute_command",
					"command": "function gem:exit_all",
					"permission_level": 4
				},
				{
					"type": "origins:change_resource",
					"resource": "*:tired_resource",
					"change": 1,
					"operation": "set"
				}
			]
		},
		"max_action": {
			"type": "origins:change_resource",
			"resource": "*:tired_resource",
			"change": 0,
			"operation": "set"
		}
	},
	"light_resource":{
		"type":"origins:resource",
		"min":0,
		"max":200,
		"hud_render": {"should_render": false},
		"max_action": {
			"type":"origins:and",
			"actions":[
				{
					"type":"origins:change_resource",
					"resource": "*:*_light",
					"change": 1
				},
				{
					"type":"origins:change_resource",
					"resource": "*:*_light_resource",
					"change": -200
				}
			]
		}
	},
	"light_up_day":{
		"type":"origins:action_over_time",
		"interval":1,
		"entity_action": {
			"type":"origins:change_resource",
			"resource": "*:*_light_resource",
			"change": 2
		},
		"condition": {
			"type":"origins:and",
			"conditions":[
				{
					"type":"origins:exposed_to_sun"
				},
				{
					"type":"origins:resource",
					"resource": "*:*_light",
					"comparison":"<",
					"compare_to":7
				}
			]
		}
	},
	"light_up_night":{
		"type":"origins:action_over_time",
		"interval":1,
		"entity_action": {
			"type":"origins:change_resource",
			"resource": "*:*_light_resource",
			"change": 1
		},
		"condition": {
			"type":"origins:and",
			"conditions":[
				{
					"type":"origins:exposed_to_sky"
				},
				{
					"type":"origins:daytime",
					"inverted": true
				},
				{
					"type":"origins:resource",
					"resource": "*:*_light",
					"comparison":"<",
					"compare_to":7
				}
			]
		}
	},
	"light_down_active": {
		"type":"origins:active_self",
		"entity_action": {
			"type":"origins:delay",
			"ticks":1,
			"action":{
				"type":"origins:and",
				"actions":[
					{
						"type":"origins:change_resource",
						"resource": "*:*_light",
						"change": -1
					},
					{
						"type":"origins:change_resource",
						"resource": "*:*_light_resource",
						"change": -200
					}
				]
			}
		},
		"cooldown":60,
		"condition": {
			"type":"origins:and",
			"conditions":[
				{
					"type":"origins:resource",
					"resource": "*:current_resource",
					"comparison": ">",
					"compare_to": 0
				},
				{
					"type":"origins:resource",
					"resource":"*:light_light",
					"comparison":">",
					"compare_to": 0
				}
			]
		}
	}
}